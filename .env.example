# Copiez ce fichier en .env et renseignez vos propres valeurs.
# Ne jamais committer le fichier .env reel.

FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=change-moi-avec-une-valeur-aleatoire-longue

# Base de donnees PostgreSQL
DATABASE_URL=postgresql+psycopg2://farmcontrol:farmcontrol@localhost:5432/farmcontrol

# Active/desactive Row Level Security cote application (doit rester True en production)
ENFORCE_RLS=True

# Envoi d'emails (SMTP)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=notifications@example.com
MAIL_PASSWORD=change-moi
MAIL_DEFAULT_SENDER=notifications@example.com

# Uploads
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=2

# Securite mots de passe / connexion
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Mode demo
DEMO_TENANT_SLUG=demo
